// Prisma schema for auto-journalist
// learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Singleton (id = "default") holding org-wide generation settings.
model OrgConfig {
  id                 String     @id @default("default")
  brandName          String     @default("Auto Journalist")
  /// Free-text instructions for tone/style passed to the script prompt.
  tone               String     @default("Clear, confident, conversational newsroom anchor. Neutral and factual; no sensationalism.")
  targetSeconds      Int        @default(45)
  defaultPresenterId String?
  defaultPresenter   Presenter? @relation(fields: [defaultPresenterId], references: [id], onDelete: SetNull)
  /// Default voice id (see src/server/voices.ts); pre-selected when generating.
  defaultVoiceId     String     @default("Brian")
  /// fal.ai TTS endpoint id, e.g. fal-ai/elevenlabs/tts/multilingual-v2
  ttsModel           String     @default("fal-ai/elevenlabs/tts/multilingual-v2")
  /// veed/subtitles preset (basic = 1x rate, dynamic = 2x rate).
  subtitlePreset     String     @default("casper")
  /// veed/subtitles source language (BCP-47), e.g. "en-GB".
  subtitleLanguage   String     @default("en-GB")
  updatedAt          DateTime   @updatedAt
}

/// A talking-head presenter (face only); voices are picked independently per video.
model Presenter {
  id         String      @id @default(cuid())
  name       String
  imageUrl   String
  sortOrder  Int         @default(0)
  configs    OrgConfig[]
  mediaItems MediaItem[]
}

/// A user-defined grouping of RSS sources.
model Folder {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  sources   Source[]
}

/// An RSS feed we poll.
model Source {
  id           String    @id @default(cuid())
  name         String
  feedUrl      String    @unique
  siteUrl      String?
  folderId     String?
  folder       Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  lastPolledAt DateTime?
  lastError    String?
  createdAt    DateTime  @default(now())
  articles     Article[]

  @@index([folderId])
}

/// A single item from a feed, enriched on demand.
model Article {
  id          String      @id @default(cuid())
  sourceId    String
  source      Source      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  guid        String
  title       String
  url         String
  publishedAt DateTime
  summary     String?
  imageUrl    String?
  /// Plain-text body from the simple HTTP fetch.
  rawContent  String?
  /// Structured result from Tavily Extract.
  extract     Json?
  enrichedAt  DateTime?
  createdAt   DateTime    @default(now())
  mediaItems  MediaItem[]

  @@unique([sourceId, guid])
  @@index([publishedAt(sort: Desc)])
}

enum MediaStatus {
  QUEUED
  ENRICHING
  SCRIPTING
  GENERATING_AUDIO
  GENERATING_VIDEO
  GENERATING_SUBTITLES
  READY
  FAILED
}

/// One generated talking-head video (plus its script and social copy).
model MediaItem {
  id                String        @id @default(cuid())
  articleId         String
  article           Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  presenterId       String
  presenter         Presenter     @relation(fields: [presenterId], references: [id])
  status            MediaStatus   @default(QUEUED)
  script            String?
  caption           String?
  voiceId           String
  audioUrl          String?
  /// Fabric talking-head video (no subtitles yet).
  videoUrl          String?
  /// Fabric output with veed/subtitles burned in — the final deliverable.
  subtitledVideoUrl String?
  falRequestId      String?
  subtitleRequestId String?
  error             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  publications      Publication[]

  @@index([createdAt(sort: Desc)])
}

enum Platform {
  X
  INSTAGRAM
}

/// A (mocked) social post of a media item.
model Publication {
  id          String    @id @default(cuid())
  mediaItemId String
  mediaItem   MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  platform    Platform
  externalUrl String?
  postedAt    DateTime  @default(now())

  @@unique([mediaItemId, platform])
}
